# angle between 2 segments in degrees. 0-180 (more positive is clockwise)
def angleBetweenSegments(seg1, seg2):
    dot = seg1[0] * seg2[0] + seg1[1] * seg2[1]
    cross = seg1[0] * seg2[1] - seg1[1] * seg2[0] 
    mag1 = math.sqrt(seg1[0]**2 + seg1[1]**2)
    mag2 = math.sqrt(seg2[0]**2 + seg2[1]**2)
    
    if mag1 == 0 or mag2 == 0:
        return 0
    
    cos = max(-1.0, min(1.0, dot / (mag1 * mag2)))
    angle = math.degrees(math.acos(cos))
    
    if cross < 0:     
        angle = -angle
    return angle

def findRelativeNormal(image, reference, target, length=25):
    h, w, _ = image.shape
    targetCoords = (int(target.x * w), int(target.y * h))
    referenceCoords = (int(reference.x * w), int(reference.y * h))
    
    refToTargetVec = np.array([
        targetCoords[0] - referenceCoords[0],
        targetCoords[1] - referenceCoords[1]
    ], dtype=np.float32)
    
    normVector = np.array([-refToTargetVec[1], refToTargetVec[0]], dtype=np.float32)
    
    norm = np.linalg.norm(normVector)
    if norm > 0:
        normVector = normVector / norm
    else:
        return np.array([0, 0], dtype=np.float32)
    
    normVector = normVector * length  # length controls arrow size
    
    normEnd = (
        int(targetCoords[0] - normVector[0]),
        int(targetCoords[1] - normVector[1])
    )
    
    cv2.arrowedLine(image, targetCoords, normEnd, (255, 255, 0), 2, tipLength=0.3)
    cv2.line(image, referenceCoords, targetCoords, (0, 0, 255), 1)
    return normVector

def clamp(angle, lowerBound, upperBound):
    if angle <= lowerBound:
        angle = lowerBound
    elif angle >= upperBound:
        angle = upperBound
    return angle    

# code to determine "bended-ness" of fingers
def getFingerBend(tip, bend, base, palm, fingerData):
    # original vertical distance
    distance = base.y - tip.y
    bendDistance = base.y - bend.y
    ratio = abs(distance/bendDistance)

    # scale reference (fingertip to palm)
    currentScale = math.dist((tip.x, tip.y), (palm.x, palm.y))

    # update max if needed
    if distance > fingerData['max']:
        fingerData['max'] = distance
        fingerData['scale'] = currentScale
    if fingerData['max'] == 0 or fingerData['scale'] == 0:
        return 0

    # adjust max for current scale
    adjustedMax = fingerData['max'] * (currentScale / fingerData['scale'])
    if adjustedMax <= 0:
        return 0
    
    distance = max(0, min(distance, adjustedMax))
    angle = 150 * (1 - (distance / adjustedMax))
    # angle = max(0, min(150, angle))
    if angle == 150:
        if ratio >= 1: angle = 180
        else:
            angle = ratio * 30 + 150
    return angle

# we use the distance between the line between ring and pinky base line to determine bendedness for the thumb
def getThumbBend(tip, pinkyBase, ringBase, fingerData):
    num = abs((pinkyBase.x - ringBase.x)*(ringBase.y - tip.y) - (ringBase.x - tip.x)*(pinkyBase.y - ringBase.y))
    den = math.sqrt((pinkyBase.x - ringBase.x)**2 + (pinkyBase.y - ringBase.y)**2)
    distance = num / den if den > 0 else 0

    currentScale = math.dist((tip.x, tip.y), (ringBase.x, ringBase.y))
    if distance > fingerData['max']:
        fingerData['max'] = distance
        fingerData['scale'] = currentScale
    if fingerData['max'] == 0 or fingerData['scale'] == 0:
        return 0
    adjustedMax = fingerData['max'] * (currentScale / fingerData['scale'])
    if adjustedMax <= 0:
        return 0
    normalized = distance / adjustedMax
    normalized = max(0, min(normalized, 1))
    angle = 180 * (1 - normalized)
    return max(0, min(180, angle))

def enhanceLighting(image):
    # Convert to LAB color space
    lab = cv2.cvtColor(image, cv2.COLOR_BGR2LAB)
    l, a, b = cv2.split(lab)
    
    # Apply CLAHE to L-channel (brightness)
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))
    lightEnhanced = clahe.apply(l)
    
    # Merge back
    labEnhanced = cv2.merge([lightEnhanced, a, b])
    return cv2.cvtColor(labEnhanced, cv2.COLOR_LAB2BGR)

def findDepthAngle(origin, target, originDepth, targetDepth, focalLength=525):
    if originDepth == 0 or targetDepth == 0:
        return 90
    avgDepth = (int(originDepth) + int(targetDepth)) / 2

    dx = ((target[0] - origin[0]) * avgDepth) / focalLength
    dy = ((target[1] - origin[1]) * avgDepth) / focalLength
    dz = int(targetDepth) - int(originDepth)

    xyDist_mm = math.sqrt(dx**2 + dy**2)
    angle = abs(90 - math.degrees(math.atan2(dz, xyDist_mm))) - 90
    return max(0, min(180, angle))

def wristRotation(midFingBase, pinkyBase, wrist, ringDepth, thumbBaseDepth):
    xA = midFingBase[0] - wrist[0]
    yA = midFingBase[1] - wrist[1]
    xB = pinkyBase[0] - wrist[0]
    yB = pinkyBase[1] - wrist[1]

    # Angle between the two vectors (angle of spread)
    dot = xA * xB + yA * yB
    magA = math.hypot(xA, yA)
    magB = math.hypot(xB, yB)
    if magA == 0 or magB == 0:
        spread = 0
    else:
        theta = dot / (magA * magB)
        theta = max(-1.0, min(1.0, theta))
        spread = math.degrees(math.acos(theta))

    norm = min(1.0, spread / 15)  
    offset = (1 - norm) * 90.0

    # Determine hand orientation using x‑coordinates 
    if midFingBase[0] > pinkyBase[0]:   # back of hand to camera
        angle = offset        
    else:                             
        angle = 90.0 + offset   
        if thumbBaseDepth > ringDepth:
            angle = 90 - angle  
            
    return angle

def smoothValue(frameValues):
    middleFive = sorted(frameValues)[2:7]
    average = np.mean(middleFive)
    return average

